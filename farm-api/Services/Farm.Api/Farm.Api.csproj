<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e542c8be-1da9-4f74-aeda-78d0facf3694</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="15.0.1" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />

    <!-- API versioning: Microsoft.AspNetCore.Mvc.Versioning is deprecated → Asp.Versioning.Mvc -->
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="NWebsec.AspNetCore.Core" Version="3.0.1" />
    <PackageReference Include="NWebsec.AspNetCore.Middleware" Version="3.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />

    <!-- Phase 1: Background jobs + Realtime -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.20" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.10" />
    <!-- Microsoft.AspNetCore.SignalR is in-box for ASP.NET Core (Microsoft.NET.Sdk.Web) - no package needed -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\Farm.Business\Farm.Business.csproj" />
  </ItemGroup>

  <!-- Asp.Versioning moved [ApiVersion] out of Microsoft.AspNetCore.Mvc into its own namespace.
       Expose it globally so existing controllers don't need a using directive per file. -->
  <ItemGroup>
    <Using Include="Asp.Versioning" />
  </ItemGroup>

</Project>
